import json
import re
import sys
import urllib.request


def extract_video_id(url):
  match = re.search(r'(?:v=|\/)([0-9A-Za-z_-]{11})', url)
  return match.group(1) if match else None


def download_video(video_url, output_filename='downloaded_video.mp4'):
  video_id = extract_video_id(video_url)
  if not video_id:
    print('Error: Invalid YouTube URL')
    sys.exit(1)

  api_url = 'https://www.youtube.com/youtubei/v1/player'
  payload = {
      'videoId': video_id,
      'context': {
          'client': {
              'clientName': 'ANDROID',
              'clientVersion': '17.31.35',
              'hl': 'en',
              'gl': 'US',
          }
      },
  }

  headers = {
      'Content-Type': 'application/json',
      'User-Agent': (
          'com.google.android.youtube/17.31.35 (Linux; U; Android 12; en_US)'
      ),
  }

  req = urllib.request.Request(
      api_url, data=json.dumps(payload).encode('utf-8'), headers=headers
  )

  try:
    with urllib.request.urlopen(req) as response:
      res_data = json.loads(response.read().decode('utf-8'))
  except Exception as e:
    print(f'API request error: {e}')
    sys.exit(1)

  streaming_data = res_data.get('streamingData', {})
  formats = streaming_data.get('formats', []) + streaming_data.get(
      'adaptiveFormats', []
  )

  stream_url = None
  for fmt in formats:
    if 'url' in fmt:
      mime = fmt.get('mimeType', '')
      if 'video/mp4' in mime and 'audio' in mime:
        stream_url = fmt['url']
        break

  if not stream_url:
    for fmt in formats:
      if 'url' in fmt:
        stream_url = fmt['url']
        break

  if not stream_url:
    print('Error: Could not extract direct video URL from YouTube API')
    sys.exit(1)

  print(f'Downloading stream to {output_filename}...')
  urllib.request.urlretrieve(stream_url, output_filename)
  print('Download completed successfully!')


if __name__ == '__main__':
  if len(sys.argv) < 2:
    print('Usage: python download.py <youtube_url>')
    sys.exit(1)
  download_video(sys.argv[1])
